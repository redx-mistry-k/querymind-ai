# Copy these values into the hosting platforms' secret/environment settings.
# Never commit the real service token or provider key.
APP_ENV=public-demo
APP_HOST=0.0.0.0
PUBLIC_DEMO_MODE=true
QUERYMIND_API_TOKEN=replace-with-a-long-random-secret

BACKEND_URL=https://replace-with-your-fastapi-service.example
FRONTEND_ORIGINS=https://replace-with-your-streamlit-app.example

# Configure at most one intentionally quota-controlled provider key.
GEMINI_API_KEY=
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=

MAX_QUERY_ROWS=250
QUERY_TIMEOUT_SECONDS=5
MAX_SQL_RETRIES=1
MAX_CONVERSATION_TURNS=4

PUBLIC_DEMO_REQUESTS_PER_MINUTE=120
PUBLIC_DEMO_LLM_CALLS_PER_MINUTE=5
PUBLIC_DEMO_LLM_CALLS_PER_SESSION=20
PUBLIC_DEMO_EXECUTIONS_PER_MINUTE=20
PUBLIC_DEMO_MAX_QUERY_ROWS=250
PUBLIC_DEMO_QUERY_TIMEOUT_SECONDS=5

# These remain blank and are rejected by the API while public mode is active.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
ALLOW_LOCAL_CUSTOM_LLM=false
DATABASE_URL=
